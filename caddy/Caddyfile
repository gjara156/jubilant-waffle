{
  acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

*.gorgejara.com {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }

  @actual host actual.gorgejara.com
  handle @actual {
    reverse_proxy actual-actual_server-1:5006
  }

  @gitea host git.gorgejara.com
  handle @gitea {
    reverse_proxy SRV01.home.arpa:3000
  }

  @memos host memos.gorgejara.com
  handle @memos {
    reverse_proxy memos:5230
  }

  @sea host sea.gorgejara.com
  handle @sea {
    reverse_proxy srv01.home.arpa:80
  }

  @paper host paper.gorgejara.com
  handle @paper {
    reverse_proxy rpi-01.home.arpa:8000
  }
  
  @haos host haos.gorgejara.com
  handle @haos {
    reverse_proxy 192.168.1.145:8123 {
      header_up Host {upstream_hostport}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-for {remote_host}
      header_up X-Forwarded-Proto {scheme}
    } 
  }

  @immich host immich.gorgejara.com
  handle @immich {
    reverse_proxy immich_server:2283
  }

  @vault host vaultwarden.gorgejara.com
  handle @vault {
    reverse_proxy vaultwarden:80
  }
	
  @pdf host pdf.gorgejara.com
  handle @pdf {
    reverse_proxy stirling-pdf:8080
  }
}

gorgejara.com {
  root * /usr/share/caddy
  file_server
  encode gzip
}
